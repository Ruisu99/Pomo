{
  "manifest_version": 3,
  "name": "Pomo Focus Blocker",
  "version": "1.0.0",
  "description": "Blocks distracting websites during Pomo focus sessions.",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
